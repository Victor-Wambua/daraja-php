  "processor": [
    {
      "name": "six deliveries credit once",
      "steps": [
        { "fixture": "stk_callback_success" }, { "fixture": "stk_callback_success" }, { "fixture": "stk_callback_success" },
        { "fixture": "stk_callback_success" }, { "fixture": "stk_callback_success" }, { "fixture": "stk_callback_success" }
      ]
    },
    {
      "name": "a failing handler releases the key",
      "steps": [
        { "fixture": "stk_callback_success", "handlerThrows": true },
        { "fixture": "stk_callback_success" },
        { "fixture": "stk_callback_success" }
      ]
    },
    {
      "name": "re-entrant delivery is in progress",
      "steps": [ { "fixture": "stk_callback_success", "reenter": true }, { "fixture": "stk_callback_success" } ]
    },
    {
      "name": "malformed payload claims no key",
      "steps": [ { "raw": "{\"Body\":{}}" }, { "fixture": "stk_callback_success" } ]
    },
    {
      "name": "amount mismatch is rejected before a key is claimed",
      "steps": [
        { "fixture": "stk_callback_success", "expected": { "kes": 1500 } },
        { "fixture": "stk_callback_success", "expected": { "kes": 1 } },
        { "fixture": "stk_callback_success", "expected": { "kes": 1 } }
      ]
    },
    {
      "name": "phone mismatch",
      "steps": [ { "fixture": "stk_callback_success", "expected": { "kes": 1, "phone": "0700000002" } }, { "fixture": "stk_callback_success", "expected": { "kes": 1, "phone": "0700000001" } } ]
    },
    {
      "name": "unknown checkout request is rejected",
      "steps": [ { "fixture": "stk_callback_success", "expected": "unknown" }, { "fixture": "stk_callback_success", "expected": { "kes": 1, "phone": "0700000001" } } ]
    },
    {
      "name": "failed callbacks are processed and skip the amount check",
      "steps": [ { "fixture": "stk_callback_cancelled", "expected": { "kes": 1500 } }, { "fixture": "stk_callback_cancelled", "expected": { "kes": 1500 } } ]
    },
    {
      "name": "a late cancel after a success is a duplicate",
      "steps": [ { "fixture": "stk_callback_success" }, { "fixture": "stk_callback_cancelled" } ]
    },
    {
      "name": "success after a cancel is a duplicate too",
      "steps": [ { "fixture": "stk_callback_cancelled" }, { "fixture": "stk_callback_success" } ]
    }
  ],

