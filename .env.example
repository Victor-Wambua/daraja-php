# Copy to .env (never commit the real file) or export these in your process manager.
# The defaults below point at the bundled mock server (bin/daraja-mock). Every value is fake.

DARAJA_ENV=sandbox                      # sandbox | production
DARAJA_BASE_URL=http://127.0.0.1:4150   # leave empty to use Safaricom's URL for DARAJA_ENV
DARAJA_CONSUMER_KEY=mock-consumer-key
DARAJA_CONSUMER_SECRET=mock-consumer-secret
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=mock-passkey-not-a-real-secret

# Only needed for B2C, Transaction Status and Reversal:
DARAJA_INITIATOR_NAME=
DARAJA_SECURITY_CREDENTIAL=             # see Daraja\Support\SecurityCredential

# Optional: comma separated callback source addresses you trust, copied from Safaricom's documentation.
DARAJA_CALLBACK_ALLOWED_IPS=
